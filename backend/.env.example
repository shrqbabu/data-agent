# Backend environment. NEVER commit real values. Copy to .env and fill.
# Android only ever receives: SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY, ANALYTICS_API_URL.

# --- Supabase ---
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role key>
SUPABASE_PUBLISHABLE_KEY=<publishable anon key>
# JWT secret used by Supabase Auth (Settings → API). Used to verify admin JWTs
# with fallback to the public JWKS endpoint.
SUPABASE_JWT_SECRET=<jwt secret>

# --- LLM (optional). All arithmetic is deterministic; the LLM only writes prose. ---
LLM_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=120

# --- File limits ---
MAX_UPLOAD_MB=100
ALLOWED_FILE_EXTENSIONS=csv,xls,xlsx

# --- SQL connectors ---
# Fernet key (cryptography.fernet) used to encrypt SQL connection secrets at rest.
# Generate:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SQL_SECRETS_KEY=<base64 fernet key>
# Allowlist of destination hosts SQL connectors may target (comma separated).
# '*' disables the allowlist (dev only).
SQL_ALLOWED_HOSTS=*

# --- Jobs ---
JOB_CONCURRENCY=2
JOB_POLL_INTERVAL_SECONDS=1.0

# --- App ---
APP_ENV=production
CORS_ORIGINS=*
